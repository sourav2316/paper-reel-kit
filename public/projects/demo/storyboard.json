        { "type": "notifications", "items": ["EMI DUE TODAY", "FAMILY GROUP · 12 NEW", "BOSS: CALL ME"], "x": 0.36, "y": 0.47, "w": 0.6, "at": 2.6, "enter": "none", "out": 4.5 },
