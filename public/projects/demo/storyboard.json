        { "type": "bubble", "x": 0.5, "y": 0.5, "w": 0.95, "at": 21.5 },
        { "type": "orbit", "items": ["EMI", "BOSS", "EXAMS", "CAREER"], "x": 0.5, "y": 0.5, "w": 0.7, "at": 21.9, "enter": "fade" },
        { "type": "prop", "name": "alarm-clock", "x": 0.62, "y": 0.69, "w": 0.15, "enter": "none", "ringing": true }
      ]
    },
    {
      "id": "study",
      "start": 24.5, "end": 28.5,
      "set": { "builtin": "lab" },
      "transitionIn": "wipe-left",
      "headlines": [
        { "at": 24.7, "small": "HIGH STRESS:", "big": "CAUGHT A COLD" }
      ],
      "layers": [
        { "type": "isotype", "rows": 8, "cols": 10, "fill": 47, "x": 0.5, "y": 0.52, "w": 0.78, "at": 25.0, "enter": "fade", "dur": 2 },
        { "type": "counter", "to": 47, "digits": 2, "suffix": "%", "x": 0.5, "y": 0.8, "w": 0.38, "at": 25.0, "dur": 2 }
      ]
    },
    {
      "id": "risk-chart",
      "start": 28.5, "end": 31.5,
      "set": { "builtin": "corkboard" },
      "transitionIn": "blur",
      "headlines": [{ "at": 28.7, "big": "THE RISK" }],
      "layers": [
        { "type": "bars", "values": [1, 2.6], "labels": ["LOW", "HIGH"], "x": 0.5, "y": 0.52, "w": 0.7, "at": 28.8, "enter": "fade" },
        { "type": "stamp", "text": "2–3×", "x": 0.7, "y": 0.3, "w": 0.3, "rotate": -6, "at": 30.2 }
      ]
    },
    {
      "id": "cta",
      "start": 31.5, "end": 35,
      "set": { "builtin": "wood-desk" },
      "transitionIn": "push",
      "headlines": [
        { "at": 31.7, "small": "WHAT'S YOUR", "big": "STRESS?" },
        { "at": 33.5, "small": "TELL US", "big": "IN THE COMMENTS" }
      ],
      "layers": [
        { "type": "prop", "name": "coffee", "x": 0.18, "y": 0.36, "w": 0.2, "enter": "none" },
        { "type": "note", "text": "MY STRESS IS:", "x": 0.45, "y": 0.53, "w": 0.66, "rotate": -3, "enter": "drop", "at": 31.8 },
        { "type": "mark", "kind": "squiggle", "x": 0.42, "y": 0.6, "w": 0.48, "h": 80, "at": 32.6, "dur": 1.8, "color": "#2b2b2b" },
        { "type": "prop", "name": "pen", "x": 0.72, "y": 0.66, "w": 0.55, "rotate": -32, "at": 32.4, "enter": "slide-left", "move": { "toX": 0.8, "at": 32.6, "dur": 1.8 } },
        { "type": "prop", "name": "glasses", "x": 0.2, "y": 0.78, "w": 0.24, "rotate": 10, "enter": "none" }
      ]
    }
