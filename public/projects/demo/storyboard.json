        { "at": 4.7, "small": "CHRONIC", "big": "STRESS?" }
      ],
      "layers": [
        { "type": "birds", "at": 0.3, "count": 4, "y": 0.3 },
        { "type": "burst", "text": "PEEP!", "x": 0.28, "y": 0.66, "w": 0.24, "at": 0.8, "out": 1.6, "sfx": "/sfx/pop.mp3" },
        { "type": "burst", "text": "HONK!", "x": 0.72, "y": 0.69, "w": 0.26, "at": 1.5, "out": 2.4 },
