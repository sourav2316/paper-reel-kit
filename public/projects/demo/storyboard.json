      "headlines": [
        { "at": 11.4, "small": "BUT", "big": "INSIDE..." },
        { "at": 13.2, "small": "YOUR BODY'S", "big": "ALARM" },
        { "at": 15.1, "small": "DANGER", "big": "TO THE BRAIN" }
