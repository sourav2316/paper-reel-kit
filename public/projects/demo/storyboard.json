      "headlines": [{ "at": 7.3, "big": "YOUR MIND SAYS" }],
      "layers": [
        { "type": "birds", "at": 7, "count": 3, "y": 0.4 },
        { "type": "prop", "name": "chai", "x": 0.2, "y": 0.73, "w": 0.13, "enter": "none" },
        { "type": "steam", "x": 0.2, "y": 0.62, "w": 0.1 },
