      "layers": [
        { "type": "body", "x": 0.47, "y": 0.62, "w": 0.95, "enter": "fade", "bell": true, "ringing": false, "out": 13.0 },
        { "type": "body", "x": 0.47, "y": 0.62, "w": 0.95, "enter": "none", "at": 13.0, "bell": true, "ringing": true, "brain": "glow" },
        { "type": "flare", "x": 0.5, "y": 0.3, "at": 15.3 }
      ]
    },
    {
      "id": "adrenaline",
      "start": 17, "end": 21,
      "set": { "builtin": "anatomy" },
