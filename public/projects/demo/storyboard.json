        { "at": 19.0, "big": "THEN CORTISOL", "bigColor": "cream" }
      ],
      "layers": [
        { "type": "body", "x": 0.5, "y": 0.6, "w": 1.0, "zoom": "torso", "enter": "fade", "adrenals": "glow", "kidneys": "on", "heart": "glow", "particles": true },
        { "type": "prop", "name": "battery", "x": 0.2, "y": 0.42, "w": 0.18, "at": 19.0, "ambient": "breathe" }
      ]
    },
    {
      "id": "overthinking",
