# FREE stock photo keys (recommended — 2 minute signup, no card):
#   https://www.pexels.com/api/       → PEXELS_API_KEY
#   https://pixabay.com/api/docs/     → PIXABAY_API_KEY (log in, key is shown on that page)
# Without them the kit still works using Openverse (no key), just with fewer clean shots.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# OPTIONAL paid AI image generation (needs billing enabled on the provider):
OPENAI_API_KEY=
GEMINI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
