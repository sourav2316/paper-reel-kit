{
  "name": "paper-reel-kit",
  "version": "1.0.0",
  "private": true,
  "description": "2.5D paper-cutout collage explainer reels (9:16) driven by a JSON storyboard",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "check": "node scripts/check.mjs",
    "transcribe": "node scripts/transcribe.mjs",
    "images": "node scripts/images.mjs",
    "render": "node scripts/render.mjs",
    "stills": "node scripts/stills.mjs",
    "typecheck": "tsc --noEmit",
    "stock": "node scripts/stock.mjs",
    "thumb": "node scripts/thumb.mjs",
    "cutout": "node scripts/cutout.mjs"
  },
  "dependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "@remotion/bundler": "^4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/google-fonts": "4.0.538",
    "@remotion/install-whisper-cpp": "4.0.538",
    "@remotion/paths": "^4.0.538",
    "@remotion/renderer": "4.0.538",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.538",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/react": "19.1.2",
    "typescript": "5.8.3"
  },
  "overrides": {
    "sharp": "$sharp"
  }
}
